{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply pop-submissions --local && wrangler dev --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler d1 migrations apply pop-submissions --remote && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.16",
    "js-yaml": "^4.1.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "typescript": "latest",
    "vitest": "^4.1.4",
    "wrangler": "^4.156.2"
  }
}
